# Environment variables for local development
# Copy this to .env and fill in real values

APP_NAME=Financial Data Normalizer
APP_VERSION=2.1.0
DEBUG=true

# ── Supabase ──
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key

# ── Stripe ──
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_METERED_PRICE_ID=price_...

# ── Gemini LLM Fallback ──
# Leave empty to disable (unmatched strings return Uncategorized).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Admin ──
# Master token for /v1/keys (list) and /v1/keys/revoke endpoints only.
# Self-serve /v1/keys/generate does NOT require this.
MASTER_ADMIN_TOKEN=admin-bootstrap-token
